NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://fas_app:<secret>@db:5432/fasos_staging
APP_BASE_URL=https://staging.findandstudy.com
BASE_URL=https://staging.findandstudy.com
PUBLIC_APP_BASE=https://staging.findandstudy.com
ALLOWED_ORIGINS=https://staging.findandstudy.com,https://staging.srv1110168.hstgr.cloud
RELEASE_ID=staging-<utc>-<commit12>

# Browser/submission worker remains dry-only by default. Dedicated status and
# lifecycle workers require their own service/process plus explicit modes.
WORKER_EXECUTION_MODES=test_login,dry
PORTAL_STATUS_WORKER_MODES=
PORTAL_STATUS_WORKER_POLL_MS=5000
PORTAL_STATUS_SWEEP_INTERVAL_MS=600000
PORTAL_LIFECYCLE_WORKER_MODES=
PORTAL_LIFECYCLE_WORKER_POLL_MS=5000

SESSION_SECRET=<64-lowercase-hex>
JWT_SECRET=<64-lowercase-hex>
ASSET_URL_SIGNING_SECRET=<64-lowercase-hex>
ENCRYPTION_KEY=<64-lowercase-hex>
EMBED_TOKEN_SECRET=<64-lowercase-hex>
AGENT_APPLICATION_TOKEN_SECRET=<64-lowercase-hex>
SSO_SHARED_SECRET=<64-lowercase-hex>

ALLOW_LIVE_INTEGRATIONS=false
EMAIL_DELIVERY_DISABLED=true
BACKGROUND_JOBS_ENABLED=false
SIGNED_CONTRACT_PDF_WORKER_ENABLED=false
AI_EXTERNAL_AUTO_REPLY_KILL_SWITCH=true
PROGRAM_TRANSLATION_WORKER_ENABLED=false
PROGRAM_TRANSLATION_CONCURRENCY=2
STUDENT_JOURNEY_V1_MODE=off
STUDENT_JOURNEY_V1_USER_IDS=
INSTITUTION_ADMISSIONS_V1_MODE=off
INSTITUTION_ADMISSIONS_V1_USER_IDS=
INSTITUTION_DATABASE_URL=postgresql://fas_institution_executor:<secret>@db:5432/fasos_staging
INSTITUTION_DB_EXECUTOR_ROLE=fas_institution_executor
INSTITUTION_ACTIVE_CONTEXT_AUDIENCE=
INSTITUTION_ACTIVE_CONTEXT_ENVIRONMENT_ID=
INSTITUTION_ACTIVE_CONTEXT_CELL_ID=
INSTITUTION_ACTIVE_CONTEXT_ISSUER_ID=
INSTITUTION_ACTIVE_CONTEXT_KEY_RING_JSON=
INSTITUTION_CASE_INTAKE_V1_MODE=off
INSTITUTION_CASE_INTAKE_V1_RELATIONSHIP_ALLOWLIST=
INSTITUTION_EVIDENCE_SHARE_V1_MODE=off
INSTITUTION_EVIDENCE_SHARE_V1_RELATIONSHIP_ALLOWLIST=
REQUEST_PERF_TELEMETRY_ENABLED=false
DORMBOOKING_23H_FOLLOWUP_ENABLED=false

# Social planning remains available only after explicit scope configuration.
# Publication/performance workers remain dormant behind the social-external
# profile. AI generation has its own social-ai profile and independent gates.
SOCIAL_OPERATIONS_V1_MODE=off
SOCIAL_OPERATIONS_TENANT_ID=
SOCIAL_OPERATIONS_ORGANIZATION_ID=
SOCIAL_OPERATIONS_DB_EXECUTOR_ROLE=
SOCIAL_PUBLICATION_WORKER_ENABLED=false
SOCIAL_PERFORMANCE_WORKER_ENABLED=false
SOCIAL_CREATIVE_WORKER_ENABLED=false
SOCIAL_AD_WORKER_ENABLED=false
SOCIAL_PROVIDER_CONNECTIVITY_ENABLED=false
SOCIAL_PROVIDER_PUBLISHING_ENABLED=false
SOCIAL_PROVIDER_ADVERTISING_ENABLED=false
SOCIAL_CREATIVE_GENERATION_ENABLED=false
SOCIAL_PUBLICATION_PROVIDER_ALLOWLIST=
SOCIAL_CREATIVE_PROVIDER_ALLOWLIST=
SOCIAL_AD_PROVIDER_ALLOWLIST=
SOCIAL_AD_MAX_CAMPAIGN_BUDGET_MINOR=100000
SOCIAL_PUBLICATION_WORKER_LEGACY_USER_ID=
SOCIAL_PUBLICATION_WORKER_ID=
SOCIAL_PERFORMANCE_WORKER_LEGACY_USER_ID=
SOCIAL_PERFORMANCE_WORKER_ID=
SOCIAL_CREATIVE_WORKER_LEGACY_USER_ID=
SOCIAL_CREATIVE_WORKER_ID=
SOCIAL_AD_WORKER_LEGACY_USER_ID=
SOCIAL_AD_WORKER_ID=
SOCIAL_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
SOCIAL_PERFORMANCE_SYNC_INTERVAL_SECONDS=21600
SOCIAL_PERFORMANCE_MAX_PUBLICATION_AGE_DAYS=180
SOCIAL_PUBLISHER_BASE_URL=
SOCIAL_PUBLISHER_ALLOWED_HOST=
SOCIAL_PUBLISHER_TOKEN=
SOCIAL_CREATIVE_BASE_URL=
SOCIAL_CREATIVE_ALLOWED_HOST=
SOCIAL_CREATIVE_TOKEN=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/var/lib/findandstudy/storage
PRIVATE_OBJECT_DIR=/var/lib/findandstudy/storage/private
PUBLIC_OBJECT_SEARCH_PATHS=/var/lib/findandstudy/storage/public
