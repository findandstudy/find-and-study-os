# =============================================================================
# Find & Study — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in the values.
# Lines marked [REQUIRED] MUST be set in production.
# Lines marked [OPTIONAL] have safe defaults or are feature-specific.
# Lines marked [BUILD-TIME] are only needed during `pnpm build`, not at runtime.
# Lines marked [REPLIT-ONLY] are auto-injected by Replit — not needed on Hostinger.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# On Hostinger: create a Postgres DB in hPanel and copy the connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/findandstudy

# Guarded inbox AI admissions workflow. Keep automatic commits off. For local
# review, enable only the manual Student/Application action button.
AI_APPLICATION_INTAKE_ACTIONS_ENABLED=false
AI_APPLICATION_INTAKE_AUTO_COMMIT=false

# Infrastructure emergency stop for every non-internal AI auto-reply transport.
# Keep true for local/review environments. This flag can only stop delivery;
# database approval remains the normal product control.
AI_EXTERNAL_AUTO_REPLY_KILL_SWITCH=true


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# [REQUIRED] Node.js environment. Must be "production" on live server.
NODE_ENV=production

# [OPTIONAL] Port the API server listens on. Default: 5000.
# Nginx reverse-proxies to this port, so usually no need to change.
PORT=5000

# [REQUIRED] Comma-separated list of allowed CORS origins (no trailing slash).
# Must include your production domain(s).
# Example: https://findandstudy.com,https://www.findandstudy.com
ALLOWED_ORIGINS=https://findandstudy.com,https://www.findandstudy.com


# -----------------------------------------------------------------------------
# AI — PASSPORT / DOCUMENT SCANNING
# -----------------------------------------------------------------------------

# [REQUIRED for AI scanning] Anthropic Claude API key.
# Used for AI-powered passport recognition and document extraction.
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# [OPTIONAL] Named Anthropic connection used by the main public website.
# Configure the encrypted credential in Admin > Integrations first, then set
# the internal key shown there (for example: claude:publicweb). Default: claude.
PUBLIC_DOCUMENT_AI_CONNECTION_KEY=claude

# [OPTIONAL] Bounded document-analysis admission controls. These queues retain
# uploads only for the current HTTP request; they do not persist document bytes.
AI_DOCUMENT_GLOBAL_CONCURRENCY=4
AI_DOCUMENT_LANE_CONCURRENCY=1
AI_DOCUMENT_CONNECTION_CONCURRENCY=2
AI_DOCUMENT_MAX_QUEUED=100
AI_DOCUMENT_MAX_QUEUED_PER_LANE=20
AI_DOCUMENT_MAX_WAIT_MS=10000


# -----------------------------------------------------------------------------
# OBJECT STORAGE (File Uploads)
# -----------------------------------------------------------------------------

# [OPTIONAL] Comma-separated paths that are publicly accessible.
# Default: empty (no public paths).
# Example: uploads/public,uploads/logos
PUBLIC_OBJECT_SEARCH_PATHS=

# [OPTIONAL] Absolute path on disk for private file storage.
# Default: empty (uses in-memory / DB storage).
# Example: /var/www/findandstudy/storage/private
PRIVATE_OBJECT_DIR=

# Local development only. When STORAGE_DRIVER=local, use an absolute directory.
# Production must point outside the code release, e.g. /var/lib/findandstudy/storage.
STORAGE_LOCAL_DIR=

# [REQUIRED for final signed-contract PDFs unless every brand supplies its own
# protected signature] Absolute path to a PNG/JPEG signature image outside the
# repository and release directory. Never commit the image itself.
MAIN_AGENCY_SIGNATURE_FILE=

# API-internal schedulers. Production defaults to disabled unless explicitly true.
# The dedicated portal automation worker remains a separate process.
BACKGROUND_JOBS_ENABLED=false

# Student Journey v1 rollout is server-controlled and defaults to off.
# Modes: off | allowlist | all. In allowlist mode provide at most 500
# comma-separated internal numeric user IDs; malformed values fail closed.
STUDENT_JOURNEY_V1_MODE=off
STUDENT_JOURNEY_V1_USER_IDS=

# Social Operations v1 is an internal planning/approval module. It never
# enables provider publishing by itself. Production defaults to off and also
# requires a non-superuser, non-BYPASSRLS executor role.
SOCIAL_OPERATIONS_V1_MODE=off
SOCIAL_OPERATIONS_TENANT_ID=
SOCIAL_OPERATIONS_ORGANIZATION_ID=
SOCIAL_OPERATIONS_DB_EXECUTOR_ROLE=
SOCIAL_PUBLICATION_WORKER_ENABLED=false
SOCIAL_PERFORMANCE_WORKER_ENABLED=false
SOCIAL_PROVIDER_CONNECTIVITY_ENABLED=false
SOCIAL_PROVIDER_PUBLISHING_ENABLED=false
SOCIAL_PUBLICATION_PROVIDER_ALLOWLIST=
SOCIAL_PUBLICATION_WORKER_LEGACY_USER_ID=
SOCIAL_PUBLICATION_WORKER_ID=
SOCIAL_PERFORMANCE_WORKER_LEGACY_USER_ID=
SOCIAL_PERFORMANCE_WORKER_ID=
SOCIAL_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
SOCIAL_PERFORMANCE_SYNC_INTERVAL_SECONDS=21600
SOCIAL_PERFORMANCE_MAX_PUBLICATION_AGE_DAYS=180
SOCIAL_PUBLISHER_BASE_URL=
SOCIAL_PUBLISHER_ALLOWED_HOST=
SOCIAL_PUBLISHER_TOKEN=

# [RECOMMENDED] Canonical public origin of the deployed app, used to absolutize
# relative asset URLs (student photo / documents) sent to external create
# webhooks (e.g. SIT n8n). Must be a public https origin reachable by the
# webhook — no trailing slash. If unset in production the SIT adapter falls back
# to https://apply.findandstudy.com, but set this explicitly to be safe.
# Example: https://apply.findandstudy.com
PUBLIC_APP_BASE=


# -----------------------------------------------------------------------------
# SEEDING — Initial Data (Run Once)
# -----------------------------------------------------------------------------

# [OPTIONAL] Password for the automatically seeded super-admin account.
# Only used on first startup if no admin user exists.
# Remove or leave empty after first run.
SEED_ADMIN_PASSWORD=

# [OPTIONAL] Password for the automatically seeded demo agent account.
# Only used on first startup if no agent exists.
# Remove or leave empty after first run.
SEED_AGENT_PASSWORD=


# -----------------------------------------------------------------------------
# BUILD-TIME — Frontend (pnpm build)
# -----------------------------------------------------------------------------

# [BUILD-TIME] Canonical site URL used in sitemap.xml and OG meta tags.
# Default: https://findandstudy.com
BASE_URL=https://findandstudy.com

# [BUILD-TIME] Vite base path if the app is served from a sub-path.
# Default: / (root). Change only if deploying to a subdirectory.
BASE_PATH=/


# -----------------------------------------------------------------------------
# REPLIT-ONLY — Auto-injected by Replit platform (do NOT set on Hostinger)
# -----------------------------------------------------------------------------

# [REPLIT-ONLY] Used for CORS allowlisting in development.
# REPLIT_DEV_DOMAIN=

# [REPLIT-ONLY] Used for CORS and email base URL detection.
# REPLIT_DOMAINS=

# [REPLIT-ONLY] Used for email base URL in transactional emails.
# REPLIT_DEPLOYMENT_URL=

# [REPLIT-ONLY] Replit platform identifier. Triggers dev-mode CORS.
# REPL_ID=


# -----------------------------------------------------------------------------
# PORTAL ADAPTERS — University application portal credentials
# Set real values in .env (never commit .env); this file contains keys only.
# -----------------------------------------------------------------------------

# SIT Portal (11 universities: Halic, Atlas, Ankara Medipol, Galata,
#             Istanbul Yeni Yuzyil, Istinye, Istanbul Aydin, Istanbul Kent,
#             Fenerbahce, Istanbul Kultur, TED)
SIT_USER=
SIT_PASSWORD=

# United Portal (Biruni, Nisantasi, Ankara Bilim)
UNITED_USER=
UNITED_PASSWORD=

# İstanbul Topkapı Üniversitesi
TOPKAPI_USER=
TOPKAPI_PASSWORD=

# Üsküdar Üniversitesi (Salesforce / apply.uskudar.edu.tr)
USKUDAR_EMAIL=
USKUDAR_PASSWORD=

# Additional Salesforce-based schools — uncomment when onboarded:
# OKAN_EMAIL=
# OKAN_PASSWORD=


# -----------------------------------------------------------------------------
# PORTAL AUTOMATION WORKER
# Settings for the findandstudy-portal-worker PM2 process.
# These are consumed by artifacts/portal-automation-worker/src/worker.ts.
# -----------------------------------------------------------------------------

# [REQUIRED for every portal worker] Immutable release identity. API and every
# worker heartbeat/job must carry the exact same value; mismatches fail closed.
# Deploy tooling should inject a value such as 20260905T120000Z-abcdef123456.
RELEASE_ID=local-development

# [OPTIONAL, fail-safe default] Capabilities of the submission/management
# worker. Keep real absent until partner verification, dry-run evidence and an
# explicit rollout decision are complete.
WORKER_EXECUTION_MODES=test_login,dry

# [REQUIRED only when starting the dedicated status worker] Use status_check
# first. Add artifact only after per-adapter download evidence is approved.
PORTAL_STATUS_WORKER_MODES=
PORTAL_STATUS_WORKER_POLL_MS=5000
PORTAL_STATUS_SWEEP_INTERVAL_MS=600000

# [REQUIRED only when starting the dedicated lifecycle worker] This authorizes
# bounded, maker-checker-approved internal stage transitions; it never grants
# portal mutation, payment or communication authority.
PORTAL_LIFECYCLE_WORKER_MODES=
PORTAL_LIFECYCLE_WORKER_POLL_MS=5000

# [OPTIONAL] Polling interval in ms when the submission queue is empty.
# Default: 5000 (5 seconds). Increase on low-traffic servers to reduce CPU.
WORKER_POLL_MS=5000

# [OPTIONAL] Stale-lock threshold in ms. Submissions locked longer than this
# are forcibly released on the next tick (crash recovery). Default: 300000 (5 min).
WORKER_STALE_MS=300000

# [OPTIONAL] Maximum number of portal jobs processed at the same time by the
# single canonical PM2 worker. Safe default: 1 (existing sequential behavior).
# Staged multi-portal rollout recommendation after local verification: 3.
WORKER_GLOBAL_CONCURRENCY=1

# [OPTIONAL] Default simultaneous slots for one portal account/lane. Keep this
# at 1 so two universities sharing credentials cannot open parallel sessions.
WORKER_DEFAULT_LANE_CONCURRENCY=1

# [OPTIONAL] Per-adapter overrides as comma-separated adapter=slots entries.
# SIT's 12+ member universities share the "sit" lane. After a controlled
# concurrency smoke test use: sit=2
WORKER_LANE_CONCURRENCY=

# [OPTIONAL] Refresh the running-row lease while a portal job is active. This
# must stay below half WORKER_STALE_MS so 6–7 minute jobs are never reclaimed
# while they are still making progress.
WORKER_HEARTBEAT_MS=30000

# [OPTIONAL] Set to "true" to force Chromium headless mode in the worker.
# The browser is always launched headless regardless of this value; the flag
# is documented here for clarity and future overrides.
PLAYWRIGHT_HEADLESS=true

# [OPTIONAL] Absolute path to a Playwright storageState directory for
# persisting browser auth sessions across worker restarts (reduces re-logins).
# Example: /var/www/findandstudy/auth
# Leave empty to disable session persistence.
AUTH_STATE_DIR=

# [OPTIONAL] Absolute path to the Chromium executable.
# Leave empty on VPS — Playwright will use the Chromium it downloads.
# On Replit: set automatically via PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH in .replit.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# [REQUIRED for portal credential DB encryption]
# 32+ character secret used to encrypt/decrypt portal credentials stored in the
# portal_credentials table (AES-256-GCM). Must match the value used by the
# API server's ENCRYPTION_KEY (they share the same secret).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Read-path performance instrumentation. Keep disabled until an observed,
# time-boxed measurement window is approved.
REQUEST_PERF_TELEMETRY_ENABLED=false
REQUEST_PERF_SAMPLE_RATE=0.05
REQUEST_PERF_SLOW_MS=750
REQUEST_PERF_EVENT_LOOP_INTERVAL_MS=60000
REQUEST_PERF_EVENT_LOOP_RESOLUTION_MS=20
NOTIFICATION_COUNT_CACHE_TTL_MS=10000

# Coalesce only explicitly opted-in, identical read operations while the first
# request is still in flight. This is not a persistent result cache.
READ_PATH_COALESCING_ENABLED=false
FACET_CACHE_ENABLED=false
FACET_CACHE_TTL_MS=300000
FACET_CACHE_MAX_ENTRIES=500
