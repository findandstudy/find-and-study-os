{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "pre-migrate": "node ./pre-migrate.mjs",
    "validate:migrations": "node ./validate-migrations.mjs",
    "verify:migration-state": "node ./verify-migration-state.mjs",
    "prepare:disposable-migration-db": "node ./prepare-disposable-migration-database.mjs",
